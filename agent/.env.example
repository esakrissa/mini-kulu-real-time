# Copy to .env.local (gitignored) and fill in from
# LiveKit Cloud -> your project -> Settings -> API keys.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. Noise cancellation (ai-coustics) is on by default; set 0 for synthetic test runs.
# AGENT_NOISE_CANCELLATION=0

# Optional. Where the end-of-turn model runs: "v1" on LiveKit Inference (default, free monthly
# allowance) or "v1-mini" on this machine's CPU (the SDK's own default outside LiveKit Cloud).
# AGENT_TURN_DETECTOR=v1
# Optional. Record session audio for LiveKit Cloud's agent insights (costs CPU; off by default).
# AGENT_RECORD_AUDIO=1

# Optional. LLM watchdog: seconds without the model's next bytes before the backup takes the
# turn, and the models in order (primary first). A primary that doesn't exist demos failover.
# AGENT_LLM_TIMEOUT_S=3
# AGENT_LLM_MODELS=google/gemma-4-31b-it,openai/gpt-4.1-mini

# Optional. TTS fallback: seconds without audio before the backup voice takes the sentence
# (keep it above AGENT_LLM_TIMEOUT_S), and the voices as model:voice, primary first.
# AGENT_TTS_TIMEOUT_S=5
# AGENT_TTS_VOICES=fishaudio/s2.1-pro:fa4c9eb3dccc4806b382b40d61c6b10a,cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Optional. ElevenLabs mode: an ElevenLabs voice (billed to your own ElevenLabs account) speaks
# first, with AGENT_TTS_VOICES as its fallback. Off by default ("inference").
# AGENT_TTS_PROVIDER=elevenlabs
# ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=          # default: the plugin's default voice
# ELEVEN_MODEL=eleven_flash_v2_5

# Optional. Agent tools from remote MCP servers, each on only when its credential is set.
# EXA_API_KEY: a web_search tool through Exa's hosted MCP server (billed per search by Exa).
# GH_MCP_TOKEN: a read_project_file tool for this repository through GitHub's remote MCP server;
# use a fine-grained token with "Public repositories" read-only access and nothing else.
# EXA_API_KEY=
# GH_MCP_TOKEN=
# AGENT_TOOL_TIMEOUT_S=4     # longest a tool call may take, connecting included
# AGENT_MAX_SEARCHES=3       # web searches per call

# Optional. Push per-stage turn latency over OTLP/HTTP (e.g. a Grafana Cloud OTLP gateway).
# Without an endpoint the latencies are only logged.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instance-id:token>
# OTEL_METRIC_EXPORT_INTERVAL=60000
