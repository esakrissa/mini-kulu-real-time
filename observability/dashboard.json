{
  "uid": "mini-kulu-latency",
  "title": "Mini-Kulu voice turn latency",
  "tags": [
    "mini-kulu",
    "livekit"
  ],
  "description": "Per-stage latency of every voice turn (agent/turn_metrics.py). Source: observability/dashboard.json",
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "regex": "/^(?!.*-usage$).*/"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "End to end p50",
      "description": "End of user speech to agent speech, over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range]) * 0))))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "End to end p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"e2e\"}[$__range]) * 0))))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Turns answered",
      "description": "Replies to a user turn (the greeting has no e2e).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"e2e\"}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"e2e\"}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"e2e\"}[$__range]) * 0)))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Turns served by a backup",
      "description": "LLM turns the watchdog gave to the backup model, plus sentences the backup voice spoke.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum((last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"llm_ttft\", model!=\"google/gemma-4-31b-it\"}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"llm_ttft\", model!=\"google/gemma-4-31b-it\"}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"llm_ttft\", model!=\"google/gemma-4-31b-it\"}[$__range]) * 0))) or vector(0)) + (sum((last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"tts_ttfb\", model!=\"fishaudio/s2.1-pro\"}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"tts_ttfb\", model!=\"fishaudio/s2.1-pro\"}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_count{stage=\"tts_ttfb\", model!=\"fishaudio/s2.1-pro\"}[$__range]) * 0))) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "p50 / p95 per stage (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, stage) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range]) * 0))))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__range]) * 0))))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (stage) ((last_over_time(mini_kulu_turn_stage_latency_seconds_count[$__range]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_count[$__range] offset $__range) or last_over_time(mini_kulu_turn_stage_latency_seconds_count[$__range]) * 0)))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p50",
              "Value #B": "p95",
              "Value #C": "samples"
            },
            "indexByName": {
              "stage": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "stage"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM first token by model",
      "description": "A failover shows up as a second series. One point per 2 minutes: the turns that ended in it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval]) * 0))))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[$__interval]) * 0))))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "interval": "2m"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 per stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, stage) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval]) * 0))))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "interval": "2m",
      "description": "One point per 2 minutes: the turns that ended in it."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p50 per stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, stage) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{}[$__interval]) * 0))))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "interval": "2m",
      "description": "One point per 2 minutes: the turns that ended in it."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "TTS first audio by model",
      "description": "A voice failover shows up as a second series. One point per 2 minutes: the turns that ended in it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval]) * 0))))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) ((last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval]) - (last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval] offset $__interval) or last_over_time(mini_kulu_turn_stage_latency_seconds_bucket{stage=\"tts_ttfb\"}[$__interval]) * 0))))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "interval": "2m"
    }
  ]
}
